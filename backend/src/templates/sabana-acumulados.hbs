<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <title>Sábana de Acumulados por Área</title>
    <style>
        @page {
            size: letter landscape;
            margin: 6mm 8mm 6mm 8mm;
            /* Márgenes moderados para aprovechar espacio */
        }

        body {
            font-family: 'Segoe UI', Helvetica, Arial, sans-serif;
            font-size: 9.5px;
            margin: 0;
            padding: 0;
            background-color: #ffffff;
            -webkit-print-color-adjust: exact;
        }

        /* 1. Contenedor Principal del Encabezado */
        .header-wrapper {
            position: relative;
            text-align: center;
            margin-bottom: 20px;
            padding-top: 0px;
        }

        /* Títulos Centrales */
        .inst-title {
            margin: 0;
            font-size: 12px;
            color: #1e3a8a;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            font-weight: 800;
            padding: 0 15%; /* Protección para que no toque los paneles de las esquinas */
            line-height: 1.2;
        }

        .report-title {
            margin: 2px 0;
            font-size: 10px;
            color: #0f172a;
            text-transform: uppercase;
            font-weight: bold;
        }

        /* Líneas de Metadatos */
        .meta-line {
            margin: 2px 0 0 0;
            font-size: 9px;
            color: #475569;
        }

        .meta-line strong {
            color: #0f172a;
        }

        /* 2. Panel de Referencia (Derecha) */
        .ref-panel {
            position: absolute;
            top: 0;
            right: 0;
            background-color: #f8fafc;
            border: 1px solid #475569;
            border-radius: 4px;
            padding: 0px;
            font-size: 9px;
        }

        .ref-table {
            border-collapse: collapse;
        }

        .ref-table th,
        .ref-table td {
            padding: 1px 2px;
            text-align: center;
            border-bottom: 1px solid #475569;
            line-height: 1.1;
        }

        .ref-table th {
            color: #475569;
            font-weight: 700;
            text-transform: uppercase;
        }

        .ref-table tr:last-child td {
            border-bottom: none;
        }

        /* 3. Tabla de Datos Principal (Columnas más compactas) */
        .data-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 10px;
            margin-top: 0px;
        }

        .data-table th,
        .data-table td {
            border: 1px solid #475569;
            padding: 1px;
            text-align: center;
            white-space: nowrap; /* Evita que el texto se divida en varias líneas */
            line-height: 1.1; /* Interlineado ajustado para ganar espacio vertical */
        }

        .data-table th {
            background-color: #f1f5f9;
            color: #1e293b;
            font-weight: 700;
            white-space: normal; /* Cambiar a normal para que el texto baje si es muy largo */
            word-wrap: break-word;
        }

        .align-left {
            text-align: left !important;
            padding-left: 3px !important;
        }

        .col-nro {
            width: 3%;
            color: #475569;
        }

        .col-nombre {
            width: 20%;
            /* Ancho controlado para el nombre del estudiante */
            font-weight: 600;
            color: #0f172a;
            text-align: left;
            white-space: normal; /* Permite que el nombre pase abajo si es muy largo */
        }

        /* Estilo estricto para las subcolumnas de las áreas */
        .col-sub {
            font-size: 8.5px;
            color: #475569;
            width: 35px; /* Forzamos un ancho objetivo delgado para SUM y N */
        }

        .data-table thead {
            display: table-header-group;
        }
        .data-table tbody {
            display: table-row-group;
        }

        .data-table tbody tr {
            break-inside: avoid;
            page-break-inside: avoid;
        }

        .data-table tbody tr:nth-child(even) {
            background-color: #f8fafc;
        }

        .val-suma {
            font-weight: 700;
            color: #000;
        }

        .val-n {
            color: #1e293b;
        }

        .nota-baja {
            color: #dc2626 !important; /* Rojo oscuro para buena impresión */
            font-weight: 700;
        }

        /* Indicador visual para impresoras monocromáticas */
        .nota-baja::after {
            content: ' \25BC'; /* Código Unicode para una flecha oscura hacia abajo (▼) */
            font-size: 7px; /* Un poco más pequeña que el número para no saturar la celda */
            color: #dc2626; /* Mismo color rojo para mantener la coherencia visual */
            margin-left: 2px; /* Pequeño espacio de separación con el número */
            vertical-align: middle;
        }
    </style>
</head>

<body>

    <div class="header-wrapper">

        <div class="ref-panel">
            <table class="ref-table">
                <tr>
                    <th>Periodo</th>
                    <th>Suma Mínima</th>
                    <th>Requisito</th>
                </tr>
                <tr>
                    <td>1</td>
                    <td>3,0</td>
                    <td>1 Nota</td>
                </tr>
                <tr>
                    <td>2</td>
                    <td>6,0</td>
                    <td>2 Notas</td>
                </tr>
                <tr>
                    <td>3</td>
                    <td>9,0</td>
                    <td>3 Notas</td>
                </tr>
                <tr>
                    <td>4</td>
                    <td>12,0</td>
                    <td>4 Notas</td>
                </tr>
            </table>
        </div>

        <h1 class="inst-title">{{nombreInstitucion}}</h1>
        <h2 class="report-title">CONSOLIDADO DE ACUMULADOS - ÁREAS ACADÉMICAS</h2>

        <div class="meta-line">
            Sede: <strong>{{sedeNombre}}</strong> &nbsp;|&nbsp;
            Año Lectivo: <strong>{{anioLectivo}}</strong> &nbsp;|&nbsp;
            Jornada: <strong>{{jornada}}</strong>
        </div>

        <div class="meta-line">
            Grado: <strong>{{gradoNombre}}</strong> &nbsp;|&nbsp;
            Grupo: <strong>{{grupoNombre}}</strong> &nbsp;|&nbsp;
            Director(a): <strong>{{directorNombre}}</strong>
        </div>

    </div>

    <table class="data-table">
        <thead>
            <tr>
                <th rowspan="2" class="col-nro">#</th>
                <th rowspan="2" class="align-left col-nombre">Estudiante</th>
                {{#each areas}}
                <th colspan="2" style="background-color: #e2e8f0; font-size: 9px; padding: 1px;">{{this}}</th>
                {{/each}}
            </tr>
            <tr>
                {{#each areas}}
                <th class="col-sub">SUM</th>
                <th class="col-sub">N</th>
                {{/each}}
            </tr>
        </thead>
        <tbody>
            {{#each estudiantes}}
            <tr>
                <td class="col-nro">{{this.numero}}</td>
                <td class="align-left col-nombre">{{this.nombreCompleto}}</td>

                {{#each this.acumulados}}
                <td class="val-suma {{#if this.esBaja}}nota-baja{{/if}}">{{this.suma}}</td>
                <td class="val-n">{{this.n}}</td>
                {{/each}}
            </tr>
            {{/each}}
        </tbody>
    </table>

</body>

</html>
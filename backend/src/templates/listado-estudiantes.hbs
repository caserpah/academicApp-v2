<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <title>Listado de Estudiantes</title>
    <style>
        @page {
            size: A4;
            margin: 10mm 15mm;
        }

        body {
            font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
            font-size: 11px;
            color: #333;
            line-height: 1.3;
        }

        /* 1. Encabezado Compacto */
        .header-container {
            width: 100%;
            display: flex;
            align-items: center;
            margin-bottom: 8px;
        }

        .logo-box {
            width: 60px;
            text-align: left;
        }

        .logo-box img {
            max-width: 50px;
            max-height: 50px;
        }

        .title-box {
            flex-grow: 1;
            text-align: center;
        }

        .title-box h2 {
            margin: 0;
            font-size: 13px;
            color: #0f172a;
        }

        .title-box h3 {
            margin: 1px 0 0;
            font-size: 11px;
            color: #0f172a;
        }

        .title-box h4 {
            margin: 1px 0 0;
            font-size: 10px;
            color: #475569;
            font-weight: normal;
        }

        /* 2. Metadatos (Sede, Grado) en texto plano */
        .meta-info {
            display: flex;
            justify-content: space-between;
            font-size: 10px;
            color: #0f172a;
            margin-bottom: 2px;
        }

        .fecha-generacion {
            text-align: left;
            color: #737e8f;
            font-size: 9px;
            margin-bottom: 8px;
        }

        /* 3. Tabla de Datos (Estudiantes) */
        table.data-table {
            width: 100%;
            border-collapse: collapse;
        }

        thead {
            display: table-header-group;
        }

        table.data-table th {
            background-color: #f1f5f9;
            color: #1e293b;
            font-size: 10px;
            padding: 6px 4px;
            border: 1px solid #232931;
            /* <-- Borde mucho más oscuro */
            text-align: center;
            font-weight: bold;
        }

        table.data-table td {
            padding: 4px;
            border: 1px solid #232931;
            /* <-- Borde mucho más oscuro */
            font-size: 10px;
            vertical-align: middle;
        }

        table.data-table tbody tr:nth-child(even) {
            background-color: #f8fafc;
        }

        .text-center {
            text-align: center !important;
        }

        .text-left {
            text-align: left !important;
        }

        /* Salto de página para el siguiente grupo */
        .page-break {
            page-break-after: always;
        }

        .page-break:last-child {
            page-break-after: auto;
        }
    </style>
</head>

<body>

    {{#each grupos}}
    <div class="page-break">

        <div class="header-container">
            <div class="logo-box">
                <img src="{{../urlEscudo}}" alt="Escudo">
            </div>
            <div class="title-box">
                <h2>{{this.institucion}}</h2>
                <h3>LISTADO DE ESTUDIANTES</h3>
                <h4>AÑO LECTIVO {{this.anioLectivo}}</h4>
            </div>

            <div style="width: 80px;"></div>
        </div>

        <!-- METADATOS COMPACTOS -->
        <div class="meta-info">
            <span>SEDE: <b>{{this.sedeNombre}}</b></span>
            <span>JORNADA: <b>{{this.jornada}}</b></span>
        </div>
        <div class="meta-info">
            <span>GRADO: <b>{{this.gradoNombre}}</b> &nbsp;|&nbsp; GRUPO: <b>{{this.grupoNombre}}</b></span>
            <span>DIRECTOR(A): <b>{{this.directorNombre}}</b></span>
        </div>

        <div class="fecha-generacion">
            Generado el: {{../fechaGeneracion}}
        </div>

        <!-- TABLA DE ESTUDIANTES -->
        <table class="data-table">
            <thead>
                <tr>
                    <th width="5%">N°</th>
                    <th width="8%">TIPO<br>DOC.</th>
                    <th width="15%">DOCUMENTO</th>
                    <th width="55%" class="text-center" style="padding-left: 8px;">APELLIDOS Y NOMBRES</th>
                    <th width="7%">EDAD</th>
                    <th width="10%">SEXO</th>
                </tr>
            </thead>
            <tbody>
                {{#each this.estudiantes}}
                <tr>
                    <td class="text-center">{{this.nro}}</td>
                    <td class="text-center">{{this.tipoDoc}}</td>
                    <td class="text-center" style="font-size: 10px; font-weight: bold;">{{this.documento}}</td>
                    <td class="text-left" style="padding-left: 8px;">{{this.apellidosNombres}}</td>
                    <td class="text-center">{{this.edad}}</td>
                    <td class="text-center">{{this.sexo}}</td>
                </tr>
                {{/each}}
            </tbody>
        </table>

    </div>
    {{/each}}

</body>

</html>
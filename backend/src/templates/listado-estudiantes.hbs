<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <title>Listado de Estudiantes</title>
    <style>
        @page {
            size: A4 portrait;
            margin: 10mm;
        }

        body {
            font-family: Arial, sans-serif;
            font-size: 11px;
            margin: 0;
            color: #000;
        }

        .header-table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 5px;
        }

        .header-table td {
            border: 1px solid #000;
            padding: 5px;
            text-align: center;
        }

        .logo-cell {
            width: 15%;
        }

        .logo-cell img {
            max-width: 60px;
            max-height: 60px;
        }

        .info-cell h2 {
            margin: 0 0 5px 0;
            font-size: 14px;
            text-transform: uppercase;
        }

        .info-cell h3 {
            margin: 0 0 3px 0;
            font-size: 12px;
        }

        .meta-table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 10px;
            font-size: 10px;
            font-weight: bold;
        }

        .meta-table td {
            padding: 3px 0;
        }

        .data-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 10px;
        }

        .data-table th,
        .data-table td {
            border: 1px solid #000;
            padding: 4px;
        }

        .data-table th {
            background-color: #f2f2f2;
            text-align: center;
            font-size: 9px;
            font-weight: bold;
        }

        .col-no {
            width: 4%;
            text-align: center;
            font-weight: bold;
        }

        .col-tipo {
            width: 6%;
            text-align: center;
        }

        .col-doc {
            width: 15%;
            font-size: 12px;
            text-align: right;
            padding-right: 5px;
        }

        .col-nombre {
            width: 55%;
            text-align: left;
            font-weight: bold;
        }

        .col-edad {
            width: 10%;
            text-align: center;
        }

        .col-sexo {
            width: 10%;
            text-align: center;
        }

        .page-break {
            page-break-after: always;
        }

        .page-break:last-child {
            page-break-after: auto;
        }
    </style>
</head>

<body>

    {{#each grupos}}
    <div class="page-break">
        <table class="header-table">
            <tr>
                <td class="logo-cell"><img src="{{../urlEscudo}}" alt="Escudo"></td>
                <td class="info-cell">
                    <h2>{{this.institucion}}</h2>
                    <h2>LISTADO DE ESTUDIANTES</h2>
                    <h4>AÑO LECTIVO {{this.anioLectivo}}</h4>
                </td>
            </tr>
        </table>

        <table class="meta-table">
            <tr>
                <td width="50%">SEDE: <b>{{this.sedeNombre}}</b></td>
                <td width="50%" style="text-align: right;">JORNADA: <b>{{this.jornada}}</b></td>
            </tr>
            <tr>
                <td width="50%">GRADO: {{this.gradoNombre}} &nbsp;&nbsp;|&nbsp;&nbsp; GRUPO: {{this.grupoNombre}}</td>
                <td width="50%" style="text-align: right;">DIRECTOR(A): <b>{{this.directorNombre}}</b></td>
            </tr>
            <tr>
                <td style="text-align: left; color: #555; font-size: 9px;">
                    Generado el: {{../fechaGeneracion}}
                </td>
            </tr>
        </table>

        <table class="data-table">
            <thead>
                <tr>
                    <th class="col-no">No.</th>
                    <th class="col-tipo">TIPO DOC.</th>
                    <th class="col-doc">DOCUMENTO</th>
                    <th class="col-nombre">APELLIDOS Y NOMBRES</th>
                    <th class="col-edad">EDAD</th>
                    <th class="col-sexo">SEXO</th>
                </tr>
            </thead>
            <tbody>
                {{#each this.estudiantes}}
                <tr>
                    <td class="col-no">{{this.nro}}</td>
                    <td class="col-tipo">{{this.tipoDoc}}</td>
                    <td class="col-doc">{{this.documento}}</td>
                    <td class="col-nombre">{{this.apellidosNombres}}</td>
                    <td class="col-edad">{{this.edad}}</td>
                    <td class="col-sexo">{{this.sexo}}</td>
                </tr>
                {{/each}}
            </tbody>
        </table>
    </div>
    {{/each}}

</body>

</html>
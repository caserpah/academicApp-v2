<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <title>Intensidad Horaria por Grupos</title>
    <style>
        @page {
            size: A4;
            margin: 12mm 15mm;
        }

        body {
            font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
            font-size: 10px;
            color: #333;
        }

        /* Encabezado Institucional */
        .header-table {
            width: 100%;
            margin-bottom: 20px;
            border-bottom: 2px solid #2563eb;
            padding-bottom: 10px;
        }

        .logo-cell {
            width: 80px;
            text-align: left;
            vertical-align: middle;
        }

        .logo-cell img {
            max-width: 70px;
            max-height: 70px;
        }

        .info-cell {
            text-align: center;
            vertical-align: middle;
        }

        .info-cell h2 {
            margin: 0;
            font-size: 16px;
            color: #1e293b;
        }

        .info-cell h3 {
            margin: 5px 0 0;
            font-size: 14px;
            color: #475569;
        }

        .info-cell h4 {
            margin: 5px 0 0;
            font-size: 12px;
            color: #64748b;
            font-weight: normal;
        }

        /* Estilos de los bloques */
        .sede-title {
            font-size: 14px;
            background-color: #1e293b;
            color: white;
            padding: 6px 10px;
            margin: 20px 0 10px 0;
            border-radius: 4px;
        }

        .grupo-container {
            margin-bottom: 20px;
            page-break-inside: avoid;
            border: 1px solid #cbd5e1;
            border-radius: 4px;
            overflow: hidden;
        }

        .grupo-header {
            background-color: #f1f5f9;
            padding: 8px 10px;
            font-weight: bold;
            border-bottom: 1px solid #cbd5e1;
            display: flex;
            justify-content: space-between;
            font-size: 11px;
        }

        /* Tablas de datos */
        table.data-table {
            width: 100%;
            border-collapse: collapse;
        }

        table.data-table th {
            background-color: #e2e8f0;
            color: #334155;
            font-size: 9px;
            padding: 6px;
            text-align: left;
            border-bottom: 1px solid #cbd5e1;
        }

        table.data-table td {
            padding: 5px 6px;
            border-bottom: 1px solid #e2e8f0;
            font-size: 9px;
            vertical-align: middle;
        }

        table.data-table tbody tr:last-child td {
            border-bottom: none;
        }

        table.data-table tbody tr:nth-child(even) {
            background-color: #f8fafc;
        }

        .text-center {
            text-align: center !important;
        }

        .total-row {
            background-color: #e2e8f0 !important;
            font-weight: bold;
        }

        /* SALTO DE PÁGINA POR SEDE */
        .sede-section {
            page-break-after: always;
        }

        .sede-section:last-child {
            page-break-after: auto;
        }
    </style>
</head>

<body>

    <table class="header-table">
        <tr>
            <td class="logo-cell"><img src="{{urlEscudo}}" alt="Escudo"></td>
            <td class="info-cell">
                <h2>{{nombreInstitucion}}</h2>
                <h3>{{titulo}}</h3>
                <h4>AÑO LECTIVO {{anioLectivo}}</h4>
            </td>
        </tr>
    </table>

    {{#each sedes}}
    <div class="sede-section">
        <table style="width: 100%; border-collapse: collapse;">
            <thead>
                <tr>
                    <td>
                        <div class="sede-title">SEDE: {{this.nombreSede}}</div>
                    </td>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>
                        {{#each this.grupos}}
                        <div class="grupo-container">
                            <div class="grupo-header">
                                <span>GRADO: {{this.gradoNombre}} - GRUPO: {{this.grupoNombre}}</span>
                                <span>DIRECTOR(A): {{this.directorNombre}}</span>
                            </div>
                            <table class="data-table">
                                <thead>
                                    <tr>
                                        <th width="12%">CÓDIGO</th>
                                        <th width="38%">ASIGNATURA</th>
                                        <th width="40%">DOCENTE ASIGNADO</th>
                                        <th width="10%" class="text-center">I.H.</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {{#each this.asignaturas}}
                                    <tr>
                                        <td>{{this.codigo}}</td>
                                        <td>{{this.nombre}}</td>
                                        <td>{{this.docente}}</td>
                                        <td class="text-center">{{this.horas}}</td>
                                    </tr>
                                    {{/each}}
                                    <tr class="total-row">
                                        <td colspan="3" style="text-align: right;">TOTAL HORAS:</td>
                                        <td class="text-center">{{this.totalHoras}}</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                        {{/each}}
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
    {{/each}}

</body>

</html>
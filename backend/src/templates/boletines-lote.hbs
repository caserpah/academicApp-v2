<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <title>{{configuracionImpresion.tituloBoletin}}</title>
    <style>
        /* =======================================================
            1. ESTILOS GLOBALES Y DE PÁGINA
           ======================================================= */
        @page {
            margin: 7mm;
        }

        .header-container {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 15px;
        }

        .header-logo {
            width: 15%;
            text-align: left;
        }

        .header-logo img {
            max-height: 70px;
            max-width: 100%;
        }

        .header-textos {
            width: 65%;
            text-align: center;
        }

        .header-textos h2 {
            margin: 0;
            font-size: 14px;
        }

        .header-textos p {
            margin: 2px 0;
            font-size: 9px;
        }

        .header-textos h3 {
            margin: 5px 0 0 0;
            font-size: 12px;
        }

        .header-rangos {
            width: 20%;
        }

        .tabla-mini-rangos {
            width: 100%;
            border-collapse: collapse;
            font-size: 8.5px;
            text-align: center;
        }

        .tabla-mini-rangos th,
        .tabla-mini-rangos td {
            border: 1px solid #000;
            padding: 2px;
        }

        .tabla-mini-rangos th {
            background-color: #f2f2f2;
            font-weight: bold;
        }

        .titulo-rangos {
            font-weight: bold;
            font-size: 9.5px;
            border-bottom: none;
        }

        .caja-dimensiones {
            margin-top: 4px;
            padding-left: 2px;
        }

        .subtitulo-dimension {
            text-decoration: underline;
            font-size: 8px;
            margin: 4px 0 2px 0;
            text-transform: uppercase;
        }

        .fila-juicio {
            display: flex;
            font-size: 10px;
            margin-bottom: 3px;
            align-items: flex-start;
            line-height: 1.25;
        }

        .col-formula {
            width: 15%;
            white-space: nowrap;
            font-weight: bold;
        }

        .col-texto {
            width: 85%;
            text-align: justify;
        }

        body {
            font-family: Arial, Helvetica, sans-serif;
            font-size: 9px;
            line-height: 1.2;
            color: #000;
            margin: 0;
            padding: 0;
        }

        .salto-pagina {
            page-break-after: always;
        }

        tr {
            page-break-inside: avoid;
        }

        /* =======================================================
            2. ESTILOS DE TABLAS
           ======================================================= */
        table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 10px;
        }

        th,
        td {
            border: 1px solid #000;
            padding: 3px 4px;
            vertical-align: middle;
        }

        th {
            background-color: #e6e6e6;
            font-weight: bold;
            text-align: center;
            font-size: 8px;
        }

        /* =======================================================
            3. CLASES ESPECÍFICAS
           ======================================================= */
        .encabezado-institucional {
            text-align: center;
            margin-bottom: 10px;
        }

        .nombre-asignatura {
            font-weight: bold;
            font-size: 10px;
        }

        .titulo-area {
            background-color: #f2f2f2;
            font-weight: bold;
            text-transform: uppercase;
            font-size: 10px;
        }

        .docente-texto {
            font-size: 10px;
            font-style: italic;
            color: #333;
            font-weight: normal !important;
            text-transform: capitalize !important;
        }

        .docente-separador::before {
            content: "|";
            margin-right: 4px;
            color: #666;
            font-style: normal;
        }

        .texto-juicio {
            font-size: 10px;
            text-align: justify;
            margin: 2px 0;
            line-height: 1.25;
        }

        .caja-recomendaciones {
            margin-top: 4px;
            border-top: 0.5px dashed #ccc;
            padding-top: 2px;
        }

        .caja-recomendaciones ul {
            font-size: 10px !important;
            line-height: 1.3;
        }

        .tabla-pie {
            width: 40%;
            float: right;
            margin-bottom: 20px;
            font-size: 8.5px;
        }

        .tabla-pie th {
            background-color: #f2f2f2;
            font-size: 9px;
        }

        .tabla-pie td:first-child,
        .tabla-pie th:first-child {
            width: 52%;
            text-align: left;
            padding-left: 4px;
        }

        .tabla-pie td:first-child {
            background-color: #f2f2f2;
            font-weight: bold;
        }

        .tabla-pie th:not(:first-child),
        .tabla-pie td:not(:first-child) {
            width: 12%;
            text-align: center;
        }

        .firma-caja {
            margin-top: 35px;
            font-size: 9.5px;
            clear: both;
            display: flex;
            flex-direction: column;
            align-items: center;
            width: 100%;
        }

        .centrado {
            text-align: center !important;
        }

        .negrita {
            font-weight: bold;
        }

        .footer-codigo {
            text-align: center;
            margin-top: 25px;
            font-size: 9px;
            border-top: 1px dashed #ccc;
            padding-top: 6px;
            color: #444;
            clear: both;
        }

        .footer-codigo span.codigo-resaltado {
            font-size: 10px;
            color: #000;
            font-weight: bold;
            letter-spacing: 1.5px;
            margin-left: 4px;
        }

        /* Estilos nuevos para el pie de página del periodo final */
        .tabla-pie-final {
            width: 100%;
            border: none;
            margin-top: 15px;
            font-size: 10px;
            margin-bottom: 20px;
        }

        .tabla-pie-final td {
            border: none;
            padding: 4px;
        }

        .concepto-definitivo {
            color: #666;
            font-size: 8.5px;
            font-weight: bold;
            text-transform: uppercase;
        }
    </style>
</head>

<body>

    {{#each estudiantes}}
    <div class="salto-pagina">

        <table>
            <!-- Definición dinámica de anchos de columna -->
            {{#if ../configuracionImpresion.esPreescolar}}
            <colgroup>
                <col style="width: 75%;">
                <col style="width: 5%;">
                <col style="width: 5%;">
                <col style="width: 15%;">
            </colgroup>
            {{else}}
            {{#if ../configuracionImpresion.esPeriodoFinal}}
            <colgroup>
                <col style="width: 48%;">
                <col style="width: 5%;">
                <col style="width: 5%;">
                <col style="width: 5%;">
                <col style="width: 5%;">
                <col style="width: 5%;">
                <col style="width: 12%;">
                <col style="width: 15%;">
            </colgroup>
            {{else}}
            {{#if ../configuracionImpresion.esValorativo}}
            <colgroup>
                <col style="width: 48%;">
                <col style="width: 5%;">
                <col style="width: 5%;">
                <col style="width: 5%;">
                <col style="width: 5%;">
                <col style="width: 5%;">
                <col style="width: 9%;">
                <col style="width: 8%;">
                <col style="width: 10%;">
            </colgroup>
            {{else}}
            <colgroup>
                <col style="width: 55%;">
                <col style="width: 5%;">
                <col style="width: 5%;">
                <col style="width: 5%;">
                <col style="width: 5%;">
                <col style="width: 5%;">
                <col style="width: 10%;">
                <col style="width: 10%;">
            </colgroup>
            {{/if}}
            {{/if}}
            {{/if}}

            <thead>
                <tr>
                    <td colspan="{{#if ../configuracionImpresion.esPreescolar}}4{{else}}{{#if ../configuracionImpresion.esPeriodoFinal}}8{{else}}{{#if ../configuracionImpresion.esValorativo}}9{{else}}8{{/if}}{{/if}}{{/if}}"
                        style="border: none; padding: 0; padding-bottom: 10px;">

                        <div class="header-container">
                            <div class="header-logo">
                                <img src="{{../encabezadoInstitucional.logoUrl}}" alt="Escudo">
                            </div>
                            <div class="header-textos">
                                <h2>{{../encabezadoInstitucional.nombre}}</h2>
                                <p>{{../encabezadoInstitucional.dane_nit}} | {{../encabezadoInstitucional.contacto}}</p>
                                <h3>{{../configuracionImpresion.tituloBoletin}} - PERIODO
                                    {{#if
                                    ../configuracionImpresion.esPeriodoFinal}}FINAL{{else}}{{../configuracionImpresion.periodoActual}}{{/if}}
                                    &nbsp;|&nbsp; AÑO LECTIVO {{../configuracionImpresion.anioLectivo}}</h3>
                            </div>
                            <div class="header-rangos">
                                <table class="tabla-mini-rangos">
                                    <thead>
                                        <tr>
                                            <th colspan="3" class="titulo-rangos">RANGOS DE DESEMPEÑO</th>
                                        </tr>
                                        <tr>
                                            <th>Desde</th>
                                            <th>Hasta</th>
                                            <th>Desempeño</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        {{#each ../rangosDesempeno}}
                                        <tr>
                                            <td>{{this.desde}}</td>
                                            <td>{{this.hasta}}</td>
                                            <td style="font-weight: bold;">{{this.desempeno}}</td>
                                        </tr>
                                        {{/each}}
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <table style="margin-bottom: 0;">
                            <tr>
                                <td style="width: 60%;"><strong>ESTUDIANTE:</strong>
                                    {{this.infoPersonal.nombreCompleto}}</td>
                                <td style="width: 40%;"><strong>No. Doc:</strong> {{this.infoPersonal.documento}}</td>
                            </tr>
                            <tr>
                                <td><strong>GRADO:</strong> {{../grupo.grado}} | <strong>GRUPO:</strong>
                                    {{../grupo.grupoNombre}}</td>
                                <td><strong>SEDE:</strong> {{../grupo.sede}} &nbsp;|&nbsp; <strong>JORNADA:</strong>
                                    {{../grupo.jornada}}</td>
                            </tr>
                        </table>

                    </td>
                </tr>

                <!-- TITULOS DE COLUMNAS DINÁMICOS -->
                <tr>
                    <th>ÁREA Ó ASIGNATURA</th>
                    <th>Fallas</th>
                    {{#if ../configuracionImpresion.esPreescolar}}
                    <th>I.H</th>
                    <th>DESEMPEÑO</th>
                    {{else}}
                    <th>P1</th>
                    <th>P2</th>
                    <th>P3</th>
                    <th>P4</th>
                    {{#if ../configuracionImpresion.esPeriodoFinal}}
                    <th>Definitiva</th>
                    <th>Desempeño</th>
                    {{else}}
                    <th>Acumulado</th>
                    <th>Estado Acum.</th>
                    {{#if ../configuracionImpresion.esValorativo}}
                    <th>Desempeño</th>
                    {{/if}}
                    {{/if}}
                    {{/if}}
                </tr>
            </thead>

            <tbody>
                {{#each this.areas}}

                {{!--==============================================
                1. ENCABEZADO DEL ÁREA
                ==============================================--}}
                <tr class="titulo-area">
                    <td>
                        {{this.nombreArea}}
                        {{#unless this.esComportamiento}}
                        {{#if ../../configuracionImpresion.esPeriodoFinal}}
                        {{#if this.asignaturas.[0].docente}}
                        <span class="docente-texto" style="margin-left: 10px;"> Prof:
                            {{this.asignaturas.[0].docente}}</span>
                        {{/if}}
                        {{else}}
                        {{#if ../../configuracionImpresion.esValorativo}}
                        {{#unless this.mostrarNombreAsignatura}}
                        {{#if this.asignaturas.[0].docente}}
                        <span class="docente-texto docente-separador" style="margin-left: 10px;">Doc:
                            {{this.asignaturas.[0].docente}}</span>
                        {{/if}}
                        {{/unless}}
                        {{/if}}
                        {{/if}}
                        {{/unless}}
                    </td>

                    {{!-- COLUMNAS DE NOTAS --}}
                    {{#if ../../configuracionImpresion.esPreescolar}}
                    <td class="centrado">{{this.fallasArea}}</td>
                    <td class="centrado">{{this.ihArea}}</td>
                    <td class="centrado" style="font-weight: bold; font-size: 8px;">{{this.desempenoArea}}</td>
                    {{else}}
                    <td class="centrado">{{this.fallasArea}}</td>
                    <td class="centrado">{{this.p1Area}}</td>
                    <td class="centrado">{{this.p2Area}}</td>
                    <td class="centrado">{{this.p3Area}}</td>
                    <td class="centrado">{{this.p4Area}}</td>
                    <td class="centrado">
                        {{this.acumuladoActualArea}}
                        {{#if this.notaNivelacion}}
                        <span style="font-size: 7.5px; color: #555; vertical-align: super; font-weight: bold;"> (Niv.)</span>
                        {{/if}}
                    </td>
                    {{#if ../../configuracionImpresion.esPeriodoFinal}}
                    <td class="centrado" style="font-weight: bold; font-size: 8px;">{{this.desempenoArea}}</td>
                    {{else}}
                    <td class="centrado">{{this.estadoGanandoPerdiendo}}</td>
                    {{#if ../../configuracionImpresion.esValorativo}}
                    <td class="centrado" style="font-weight: bold; font-size: 8px;">{{this.desempenoArea}}</td>
                    {{/if}}
                    {{/if}}
                    {{/if}}
                </tr>

                {{!--==============================================
                2. CONTENIDO: BIFURCACIÓN ENTRE PERIODO FINAL Y REGULAR
                ==============================================--}}
                {{#unless this.esComportamiento}}

                {{#if ../../configuracionImpresion.esPeriodoFinal}}

                {{!-- A. VISTA DEL PERIODO FINAL --}}
                {{#unless ../../configuracionImpresion.esValorativo}}
                {{!-- Boletín Descriptivo Final: Muestra el Concepto Definitivo --}}
                <tr>
                    <td colspan="8" style="padding: 3px 10px; font-size: 10px; background-color: #fafafa;">
                        <span class="concepto-definitivo">CONCEPTO DEFINITIVO</span><br>
                        {{#if this.notaNivelacion}}
                        <div style="margin-bottom: 2px; font-size: 9px; font-style: italic; color: #333;">
                            <strong>* Nota de recuperación:</strong> El estudiante presentó actividades de nivelación,
                            alcanzando una valoración de {{this.notaNivelacion}}.
                        </div>
                        {{/if}}
                        <span style="text-align: justify; display: block; margin-top: 2px;">
                            {{this.juicioAutomaticoArea}}
                        </span>
                    </td>
                </tr>
                {{/unless}}

                {{else}}

                {{!-- B. VISTA REGULAR (PERIODOS 1 AL 4) --}}
                {{#each this.asignaturas}}

                {{#if ../../../configuracionImpresion.esValorativo}}
                {{#if ../mostrarNombreAsignatura}}
                <tr>
                    <td colspan="9">
                        <span class="nombre-asignatura">{{this.nombreAsignatura}}</span>
                        {{#if this.formulaPorcentajeExtra}}
                        <span style="font-size: 9px; font-style: italic;">{{this.formulaPorcentajeExtra}}</span>
                        {{/if}}
                        {{#if this.docente}}
                        <span class="docente-texto" style="margin-left: 10px;">| Doc: {{this.docente}}</span>
                        {{/if}}
                    </td>
                </tr>
                {{/if}}
                {{else}}
                <tr>
                    <td colspan="{{#if ../../../configuracionImpresion.esPreescolar}}4{{else}}8{{/if}}">
                        {{#if ../mostrarNombreAsignatura}}
                        <span class="nombre-asignatura">{{this.nombreAsignatura}}</span>
                        {{#if this.formulaPorcentajeExtra}}
                        <span style="font-size: 9px; font-style: italic;">{{this.formulaPorcentajeExtra}}</span>
                        {{/if}}
                        <br>
                        {{/if}}
                        {{#if this.docente}}
                        <span class="docente-texto">Docente: {{this.docente}}</span>
                        {{/if}}
                    </td>
                </tr>
                {{/if}}

                {{#if this.gruposDimensiones.length}}
                <tr>
                    <td colspan="{{#if ../../../configuracionImpresion.esPreescolar}}4{{else}}{{#if ../../../configuracionImpresion.esValorativo}}9{{else}}8{{/if}}{{/if}}"
                        style="padding: 2px 10px; border-top: none;">
                        <div class="caja-dimensiones">
                            {{#each this.gruposDimensiones}}
                            <div class="subtitulo-dimension">{{this.tituloCabecera}}</div>
                            {{#each this.dimensiones}}
                            <div class="fila-juicio">
                                <div class="col-formula">{{this.formula}}</div>
                                <div class="col-texto">{{this.juicio}}</div>
                            </div>
                            {{/each}}
                            {{/each}}
                        </div>
                    </td>
                </tr>
                {{/if}}

                {{#if this.recomendaciones.length}}
                <tr>
                    <td colspan="{{#if ../../../configuracionImpresion.esPreescolar}}4{{else}}{{#if ../../../configuracionImpresion.esValorativo}}9{{else}}8{{/if}}{{/if}}"
                        style="padding: 2px 10px;">
                        <div class="caja-recomendaciones">
                            <span class="negrita" style="font-size: 8px;">OBSERVACIONES:</span>
                            <ul style="margin: 2px 0 0 0; padding-left: 15px;">
                                {{#each this.recomendaciones}}
                                <li>{{this}}</li>
                                {{/each}}
                            </ul>
                        </div>
                    </td>
                </tr>
                {{/if}}

                {{/each}} {{!-- Fin del #each asignaturas --}}

                {{/if}} {{!-- Fin de la bifurcación esPeriodoFinal --}}

                {{else}}
                {{!-- 3. CASO ESPECIAL: COMPORTAMIENTO --}}
                {{#if ../../configuracionImpresion.esPeriodoFinal}}
                {{!-- EN EL BOLETÍN FINAL: El texto consolidado viene de calificaciones_areas --}}
                {{#if this.juicioAutomaticoArea}}
                <tr>
                    <td colspan="{{#if ../../configuracionImpresion.esPreescolar}}4{{else}}8{{/if}}"
                        style="padding: 6px 10px; font-size: 10px; border-bottom: 2px solid #000;">

                        <span
                            style="font-weight: bold; font-style: italic; text-transform: uppercase; font-size: 10px; display: block; margin-bottom: 4px;">
                            OBSERVACIONES DE COMPORTAMIENTO
                        </span>

                        <span style="text-align: justify; display: block;">
                            {{this.juicioAutomaticoArea}}
                        </span>
                    </td>
                </tr>
                {{/if}}
                {{else}}
                {{!-- EN PERIODOS REGULARES (1 AL 4): El texto proviene de las notas por periodos --}}
                {{#if this.textoComportamiento}}
                <tr>
                    <td colspan="{{#if ../../configuracionImpresion.esPreescolar}}4{{else}}{{#if ../../configuracionImpresion.esValorativo}}9{{else}}8{{/if}}{{/if}}"
                        style="padding: 6px 10px; font-size: 10px; border-bottom: 2px solid #000;">

                        <span style="text-align: justify; display: block;">
                            {{this.textoComportamiento}}
                        </span>
                    </td>
                </tr>
                {{/if}}
                {{/if}}
                {{/unless}}

                {{/each}} {{!-- Fin del #each this.areas --}}
            </tbody>
        </table>

        {{#unless ../configuracionImpresion.esPreescolar}}

        {{#if ../configuracionImpresion.esPeriodoFinal}}
        <!-- PIE DE PÁGINA PARA EL INFORME FINAL (Como en la foto) -->
        <table class="tabla-pie-final">
            <tr>
                <td style="width: 50%; text-align: left;">
                    <strong>Promedio del Grupo</strong>
                    <span style="margin-left: 20px;">{{#if
                        ../grupo.promedioGrupoHistorico.p4}}{{../grupo.promedioGrupoHistorico.p4}}{{else}}{{#if
                        ../grupo.promedioGrupoHistorico.p3}}{{../grupo.promedioGrupoHistorico.p3}}{{else}}{{../grupo.promedioGrupoHistorico.p2}}{{/if}}{{/if}}</span>
                </td>
                <td style="width: 50%; text-align: right;">
                    <strong>Puesto del Estudiante en el Grupo</strong>
                    <span style="margin-left: 10px;">{{#if
                        this.cuadroHistorico.puestosEstudiante.p4}}{{this.cuadroHistorico.puestosEstudiante.p4}}{{else}}{{#if
                        this.cuadroHistorico.puestosEstudiante.p3}}{{this.cuadroHistorico.puestosEstudiante.p3}}{{else}}{{this.cuadroHistorico.puestosEstudiante.p2}}{{/if}}{{/if}}
                        Entre {{this.cuadroHistorico.totalEstudiantes}}</span>
                </td>
            </tr>
            <tr>
                <td style="text-align: left;">
                    <strong>Promedio del Estudiante en el Grupo</strong>
                    <span style="margin-left: 20px;">{{#if
                        this.cuadroHistorico.promediosEstudiante.p4}}{{this.cuadroHistorico.promediosEstudiante.p4}}{{else}}{{#if
                        this.cuadroHistorico.promediosEstudiante.p3}}{{this.cuadroHistorico.promediosEstudiante.p3}}{{else}}{{this.cuadroHistorico.promediosEstudiante.p2}}{{/if}}{{/if}}</span>
                </td>
                <td style="text-align: right;">
                    <strong>Promocion:</strong>
                    <span
                        style="margin-left: 10px; font-weight: bold; text-transform: uppercase;">{{this.infoPersonal.estadoPromocion}}</span>
                </td>
            </tr>
        </table>

        {{else}}
        <!-- PIE DE PÁGINA REGULAR (Tabla de promedios P1, P2, P3, P4) -->
        <table class="tabla-pie">
            <tr>
                <th>PERIODO</th>
                <th>1</th>
                <th>2</th>
                <th>3</th>
                <th>4</th>
            </tr>
            <tr>
                <td>PUESTO OCUPADO ENTRE {{this.cuadroHistorico.totalEstudiantes}}</td>
                <td>{{this.cuadroHistorico.puestosEstudiante.p1}}</td>
                <td>{{this.cuadroHistorico.puestosEstudiante.p2}}</td>
                <td>{{this.cuadroHistorico.puestosEstudiante.p3}}</td>
                <td>{{this.cuadroHistorico.puestosEstudiante.p4}}</td>
            </tr>
            <tr>
                <td>PROMEDIO DEL ESTUDIANTE</td>
                <td>{{this.cuadroHistorico.promediosEstudiante.p1}}</td>
                <td>{{this.cuadroHistorico.promediosEstudiante.p2}}</td>
                <td>{{this.cuadroHistorico.promediosEstudiante.p3}}</td>
                <td>{{this.cuadroHistorico.promediosEstudiante.p4}}</td>
            </tr>
            <tr>
                <td>PROMEDIO DEL GRUPO</td>
                <td>{{../grupo.promedioGrupoHistorico.p1}}</td>
                <td>{{../grupo.promedioGrupoHistorico.p2}}</td>
                <td>{{../grupo.promedioGrupoHistorico.p3}}</td>
                <td>{{../grupo.promedioGrupoHistorico.p4}}</td>
            </tr>
        </table>
        {{/if}}

        {{/unless}}

        <div class="firma-caja">
            <p style="margin: 0;">_____________________________________</p>
            <p style="margin: 3px 0 0 0;" class="negrita">{{../grupo.directorGrupo}}</p>
            <p style="margin: 0;">DIRECTOR DE GRUPO</p>
        </div>

        <div class="footer-codigo">
            Para descargar una copia digital del boletín descriptivo, ingrese a
            https://plataformaiecau.com/descargar-boletin con el código:
            <span class="codigo-resaltado">{{this.codigoVerificacion}}</span>
        </div>

    </div>
    {{/each}}

</body>

</html>